{
  "name": "task-rooms-template",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vinext build",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "setup:check": "node scripts/setup-check.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261025.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.11",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.3.0",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "type": "module",
  "overrides": {
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "baseline-browser-mapping": "2.11.0",
    "esbuild": "0.28.1",
    "browserslist": "4.28.7",
    "fast-uri": "3.1.9",
    "fflate": "0.7.5",
    "undici": "7.30.1"
  },
